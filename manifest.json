{
  "manifest_version": 3,
  "name": "YouTube RSS",
  "version": "1.0.0",
  "description": "Copy the YouTube channel or playlist RSS feed URL from the page source.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://youtube.com/*",
    "https://youtu.be/*"
  ],
  "action": {
    "default_title": "Copy YouTube RSS feed",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
